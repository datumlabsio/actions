# datum-config: sqlfluff v2
# Vendored from datumlabsio/actions/configs/.sqlfluff. Bump it, do not edit it.
#
# One shared SQL config for dbt and everything else (DES §5). Rules only — no
# path-shaped keys, because this file sits at a different depth in every repo.
#
# The dbt templater needs a working dbt project to resolve ref() and source().
# A repo with no dbt project overrides `templater` to `jinja` in its own
# .sqlfluffignore-adjacent settings, or passes templater: jinja to the workflow.

[sqlfluff]
dialect = ansi
templater = dbt
max_line_length = 120
exclude_rules = RF01
# RF01 (references must resolve) is excluded because the dbt templater already
# fails on an unresolvable ref, and sqlfluff duplicates it noisily on sources.

[sqlfluff:indentation]
indented_joins = False
indented_using_on = True
template_blocks_indent = False

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
# ClickHouse function names are CASE-SENSITIVE and camelCase by convention:
# toDateTime, toStartOfMonth, toYYYYMM. With dialect = ansi, CP03 does not
# recognise them as function names and `sqlfluff fix` rewrites toDateTime to
# todatetime -- which is not a function, so the model breaks at run time on the
# production warehouse. It happened on polaris.
#
# Setting dialect = clickhouse does NOT help: CP03 applies the policy regardless
# of dialect. Measured, not assumed.
#
# This exempts the camelCase `to*` family and nothing else. COUNT and Sum are
# still findings.
ignore_words_regex = ^to[A-Z]

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:references.keywords]
# `month` is the idiomatic column name on a monthly fact table, and RF04 flags it
# because ANSI reserves MONTH. Forcing month_start on every monthly mart in the
# org is the linter dictating analytics naming, so this one word is exempt.
# `year`, `order`, `select` and the rest are still findings -- ignore_words is
# scoped to exactly what it lists.
ignore_words = month

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent
